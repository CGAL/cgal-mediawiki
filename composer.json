{
  "name": "cgal/cgalwiki",
  "type": "wiki",
  "require": {
    "mediawiki/core": "^1.43",
    "mediawiki/semantic-media-wiki": "^5.0",
    "mediawiki/parser-hooks": "^1.6",
    "data-values/data-values": "^3.1",
    "data-values/interfaces": "^1.0",
    "data-values/common": "^1.1",
    "data-values/validators": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Cgal\\Cgalwiki\\": "src/"
    }
  },
  "minimum-stability": "beta",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "wikimedia/composer-merge-plugin": true
    }
  },
  "extra": {
    "merge-plugin": {
      "include": [
        "extensions/WikiMarkdown/composer.json"
      ]
    }
  }
}
