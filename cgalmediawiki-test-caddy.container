[Unit]
Requires=cgalmediawiki-test-mediawiki.service
After=cgalmediawiki-test-mediawiki.service

[Container]
ContainerName=cgalmediawiki_test_caddy
Image=docker.io/library/caddy:2.8-alpine
Entrypoint=["/usr/bin/caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
EnvironmentFile=/etc/CGAL/cgal-mediawiki/production-test.env
Secret=CGAL_MEMBERS_PASSWORD,type=env
Secret=CGAL_EDITORS_PASSWORD,type=env
PublishPort=54.37.95.216:443:443/tcp
PublishPort=54.37.95.216:443:443/udp
PublishPort=54.37.95.216:80:80/tcp
Volume=cgalmediawiki_test_caddy-data:/data:Z
Volume=/etc/CGAL/cgal-mediawiki/config/Caddyfile:/etc/caddy/Caddyfile:ro,z
Network=cgalmediawiki-test.network

[Service]
Restart=on-failure
# Extend Timeout to allow time to pull the image
TimeoutStartSec=900

[Install]
# Start by default on boot
WantedBy=multi-user.target default.target
